#!/bin/zsh
# mkcard — build the Cannonball boot SD card, deterministically.
#
# usage: mkcard [--stage <dir>] [/Volumes/PI-OUTRUN]
#
# ERASES the target volume's contents and rebuilds them from pinned,
# hash-verified inputs. The same repo state always produces the same card:
#
#   - Raspberry Pi firmware at the revision Circle's boot Makefile pins,
#     every file verified against the sha256 manifest below;
#   - armstub8-rpi4.bin built from the vendored Circle armstub source with
#     the repo toolchain (cached once built, hash-verified);
#   - the three kernel images from host/build/ — this script does NOT build
#     them, run `make kernels` first;
#   - config.txt and cmdline.txt from host/;
#   - res/ binaries (widescreen tilemaps, controller db) from cannonball/res/;
#   - /config.xml from cannonball/res/config.xml with the edits a bare-metal
#     card needs: video mode 0->1 (fullscreen; windowed is meaningless here),
#     sound rate 48000->44100 (the rate the shim is proven at), hi-res
#     internal rendering on, and the repaired PCM sample ROM.
#
# Downloads are cached in the repo scratchpad/ and only fetched when absent
# or hash-stale. Bounded and never silent: ends with CARD-READY or dies
# with a reason.
#
# THE ROMS ARE NOT PUT ON THE CARD HERE, and cannot be: Cannonball needs the
# original arcade ROM set, which is copyrighted and is not this project's to
# distribute. The card is finished except for them — an empty roms/ directory
# is created and the game's own roms.cpp names what belongs in it. Supply
# them and the card boots.

set -e
set -o pipefail

ROOT=${0:A:h:h}

STAGE_DIR=0
argv_paths=()
for arg in "$@"; do
    case $arg in
        --stage) STAGE_DIR=1 ;;
        -*)      print -u2 "usage: mkcard [--stage] [/Volumes/PI-OUTRUN | dir]"; exit 1 ;;
        *)       argv_paths+=$arg ;;
    esac
done
CARD=${argv_paths[1]:-/Volumes/PI-OUTRUN}

CACHE=$ROOT/scratchpad
FW=$CACHE/firmware

# Pinned input: the firmware revision Circle's boot/Makefile builds against.
FIRMWARE_REV=0641c5bf25d185d5bf25d8dcafd1da6dc8fdbf68
FIRMWARE_URL=https://github.com/raspberrypi/firmware/raw/$FIRMWARE_REV/boot

CIRCLE=$ROOT/circle-libsdl2/circle-stdlib-rpi5/libs/circle

die() { print -u2 "mkcard: $*"; exit 1 }

# sha256 manifest of every downloaded or built input. "name sha" pairs;
# names are relative to $FW except the ROM zip.
typeset -A WANT
while read -r name sha; do
    [[ -n $name ]] && WANT[$name]=$sha
done <<'MANIFEST'
bootcode.bin 4948532b1c5b60935388301715154ad8d3ed394727568d830ea883468a3f5ef9
start.elf 14d54df30f437e2120dd99f81ae0427ad033a7ed258e20b366a5ffcff5633e35
fixup.dat bf23063135feaba121b2a8340cc1d25425d921551c8cb3446efd21f3aa50f396
start4.elf 61d198caf99fdf3b82467dc7b5319a6bae1a99fe22c94fdafaa86711490a0c23
fixup4.dat 304b53a7a5a7129531b2674b0fd55240086c5bbd276ff029c63cd68fcf28c0e1
start_cd.elf 0323487b6151ceae1e82355861df71a5df61458af2347cc33386324cea298d80
fixup_cd.dat 788e6403b1e1c6d7e86b8a5de5748434f55d898b0c36c2bb27cc991649de0a4f
start4cd.elf f5f12336d7e4146372ed9aca9f64e0ee0c3fe06658ee01927c819b5687c64b6b
fixup4cd.dat 788e6403b1e1c6d7e86b8a5de5748434f55d898b0c36c2bb27cc991649de0a4f
bcm2710-rpi-zero-2-w.dtb 489497a260b2b541fc6921faa9547176456d692027e4a5cc7f3a578756dd2289
bcm2710-rpi-cm0.dtb 8873af4c735ae967b42d9f4bcf4888db1ecc01ef7d4b48ed033a8757220caf0d
bcm2711-rpi-4-b.dtb 78327a03eb80f4ce8869768541a116c17894f37e52475332892ac6eee1644437
bcm2711-rpi-400.dtb 7e0450715735c0165e9f65648ff712dd135cb0a4507be016f1ba049f1f751ed9
bcm2711-rpi-cm4.dtb c8b4a22717cf9f76fb454f08f1d6ec41030dfc2c57583a6f3a29bdb6c345bda5
bcm2712-rpi-5-b.dtb 8cad559d0b557b256dfacaab4f2a879fba3a97b526473a1d2c07df28cb6f164a
bcm2712d0-rpi-5-b.dtb 9003c3b6243a0fa0b19b30ac6cae7e9f5fe8dc93d9342064a2623f4916040abd
bcm2712-rpi-500.dtb f24adc13e8004ef639f8276946afab0fe60435db88b639053d8e84ac0cbddc4a
bcm2712-rpi-cm5-cm5io.dtb dd69d7e8bcff5afd1e818140567f5937bed0e441f43fe7714f2ea9f4134f7b41
bcm2712-rpi-cm5l-cm5io.dtb 51edf5a403aed9fd0a0e6b3647ec23128b02cc96127ecd4d5362c4429e1d0bac
LICENCE.broadcom c7283ff51f863d93a275c66e3b4cb08021a5dd4d8c1e7acc47d872fbe52d3d6b
COPYING.linux af8067302947c01fd9eee72befa54c7e3ef8a48fecde7fd71277f2290b2bf0f7
overlays/bcm2712d0.dtbo b73210c9256ff4b4963365f9acc49c0f7449f17eeddf21355e23dd011da899ec
armstub8-rpi4.bin aa08182481bfd98788e66633795aef1b6b8af065c525395141f9e5c61716015e
MANIFEST

sha_of() { shasum -a 256 "$1" | cut -d' ' -f1 }

fresh() {  # fresh <path> <manifest-name> — true if present and hash-good
    [[ -f $1 ]] && [[ $(sha_of "$1") == ${WANT[$2]} ]]
}

# --- sanity -----------------------------------------------------------------

# --stage: the target is a plain directory — a card TREE to copy onto a
# card formatted elsewhere — so the mount checks don't apply.
if (( STAGE_DIR )); then
    mkdir -p "$CARD"
else
    [[ -d $CARD ]] || die "$CARD is not mounted"
    mount | grep -q " $CARD (msdos" || die "$CARD is not a FAT volume"
fi

typeset -A KERNELS
KERNELS=(
    kernel8.img       $ROOT/host/build/rpi3/kernel8.img
    kernel8-rpi4.img  $ROOT/host/build/rpi4/kernel8-rpi4.img
    kernel_2712.img   $ROOT/host/build/rpi5/kernel_2712.img
)
for name src in "${(@kv)KERNELS}"; do
    [[ -f $src ]] || die "$src missing — run 'make kernels' first"
done

# What actually lands in each boot slot on this card.
typeset -A SLOTS
SLOTS=("${(@kv)KERNELS}")

# --- firmware ---------------------------------------------------------------

mkdir -p "$FW/overlays"
for name in ${(k)WANT}; do
    case $name in
        armstub8-rpi4.bin)
            continue ;;
    esac
    if ! fresh "$FW/$name" "$name"; then
        print "  FETCH $name"
        curl -fsSL --max-time 120 -o "$FW/$name" "$FIRMWARE_URL/$name" \
            || die "download failed: $name"
        fresh "$FW/$name" "$name" || die "hash mismatch after download: $name"
    fi
done

# --- armstub (Pi 4 FIQ boot stub, built from the vendored Circle source) ----

if ! fresh "$FW/armstub8-rpi4.bin" armstub8-rpi4.bin; then
    print "  BUILD armstub8-rpi4.bin"
    # The same places mk/toolchain.mk looks, in the same order: PATH, then
    # $RAPI_TOOLCHAIN_DIR, then this repository's own toolchains/. Either
    # directory may hold unpacked releases or be one itself.
    if ! command -v aarch64-none-elf-gcc >/dev/null 2>&1; then
        tc=(
            ${RAPI_TOOLCHAIN_DIR:+$RAPI_TOOLCHAIN_DIR/arm-gnu-toolchain-*-aarch64-none-elf/bin(N)}
            ${RAPI_TOOLCHAIN_DIR:+$RAPI_TOOLCHAIN_DIR/bin(N)}
            "$ROOT"/toolchains/arm-gnu-toolchain-*-aarch64-none-elf/bin(N)
        )
        [[ -n ${tc[1]-} ]] || die "aarch64-none-elf toolchain not found (PATH, \$RAPI_TOOLCHAIN_DIR or toolchains/)"
        path=($tc[1] $path)
    fi
    make -C "$CIRCLE/boot/armstub" armstub8-rpi4.bin PREFIX64=aarch64-none-elf- >/dev/null
    cp "$CIRCLE/boot/armstub/armstub8-rpi4.bin" "$FW/"
    make -C "$CIRCLE/boot/armstub" clean >/dev/null
    [[ -z $(git -C "$CIRCLE" status --porcelain) ]] \
        || die "vendored Circle tree left dirty by armstub build — inspect $CIRCLE"
    fresh "$FW/armstub8-rpi4.bin" armstub8-rpi4.bin \
        || die "armstub hash mismatch — different toolchain than the pinned 15.2.Rel1?"
fi

# --- config.xml -------------------------------------------------------------

sed -e 's|<mode>0</mode>|<mode>1</mode>|' \
    -e 's|<rate>48000</rate>|<rate>44100</rate>|' \
    -e 's|<hires>0</hires>|<hires>1</hires>|' \
    -e 's|<fix_samples>0</fix_samples>|<fix_samples>1</fix_samples>|' \
    "$ROOT/cannonball/res/config.xml" > "$CACHE/card-config.xml"
grep -q '<mode>1</mode>' "$CACHE/card-config.xml" \
    || die "upstream config.xml drifted — video mode edit did not apply"
grep -q '<rate>44100</rate>' "$CACHE/card-config.xml" \
    || die "upstream config.xml drifted — sound rate edit did not apply"
grep -q '<hires>1</hires>' "$CACHE/card-config.xml" \
    || die "upstream config.xml drifted — hi-res edit did not apply"
grep -q '<fix_samples>1</fix_samples>' "$CACHE/card-config.xml" \
    || die "upstream config.xml drifted — fixed samples edit did not apply"

# --- write the card ---------------------------------------------------------

# How to copy onto the card. macOS cp carries extended attributes across, which
# on FAT become clutter the Pi firmware has to wade through, so -X suppresses
# them there. GNU cp has neither the flag nor the problem and rejects -X
# outright, which is why this is not a constant. Written as an if rather than a
# && so a non-macOS host does not end on a false test under `set -e`.
CP=(cp)
if [[ $OSTYPE == darwin* ]]; then
    CP+=(-X)
fi

print "  WIPE  $CARD"
find "$CARD" -mindepth 1 -maxdepth 1 \
    ! -name '.fseventsd' ! -name '.Spotlight-V100' ! -name '.Trashes' \
    -exec rm -rf {} +

print "  COPY  firmware, kernels, configs, res"
for name in ${(k)WANT}; do
    case $name in
    esac
    mkdir -p "$CARD/${name:h}"
    "${CP[@]}" "$FW/$name" "$CARD/$name"
done
for name src in "${(@kv)SLOTS}"; do
    "${CP[@]}" "$src" "$CARD/$name"
done
"${CP[@]}" "$ROOT/host/config.txt" "$ROOT/host/cmdline.txt" "$CARD/"
"${CP[@]}" "$CACHE/card-config.xml" "$CARD/config.xml"

mkdir -p "$CARD/roms" "$CARD/res"
"${CP[@]}" "$ROOT/cannonball/res/tilemap.bin" "$ROOT/cannonball/res/tilepatch.bin" \
      "$ROOT/cannonball/res/gamecontrollerdb.txt" "$CARD/res/"

# macOS sprays AppleDouble ._* files onto FAT regardless of the copy flags.
dot_clean -m "$CARD" 2>/dev/null || true
find "$CARD" -name '._*' -delete

# --- verify what actually landed --------------------------------------------

# A card without one of these boots into a firmware default — a mode nobody
# asked for, or no game at all — and says nothing about why. Ask the card.
for name in config.txt cmdline.txt config.xml; do
    [[ -s "$CARD/$name" ]] || die "missing or empty on card: $name"
done
for name src in "${(@kv)SLOTS}"; do
    cmp -s "$CARD/$name" "$src" || die "boot image differs on card: $name"
done
sync
print "CARD-READY $CARD"
print "  ROMS  roms/ is EMPTY — copy the OutRun ROM set into it before booting"
